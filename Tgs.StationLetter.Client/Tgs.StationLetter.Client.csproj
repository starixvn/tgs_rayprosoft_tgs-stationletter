<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SqlQueryToolsConnectionString />
    <RootNamespace>Tgs.StationLetterService.Client</RootNamespace>
    <PackageId>Tgs.StationLetter.Client</PackageId>
    <Title>站內信ApiClient</Title>
    <Version>0.0.7</Version>
    <Authors>Raypro</Authors>
    <PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-stationletter</PackageProjectUrl>
    <RepositoryUrl>https://gitlab.com/rayprosoft/tgs-stationletter.git</RepositoryUrl>
    <PackageTags>Tgs StationLetter</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="7.0.0" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.5.22">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PhoenixToolkits.NuGet.BuildTools" Version="0.0.2">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Interactive.Async" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tgs.StationLetter.Common\Tgs.StationLetter.Common.csproj">
      <PrivateAssets>All</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
